# Credentials for frigate-watchdog. Copy to .env.watchdog next to
# compose.yaml and fill in every variable your config references via
# password_env. Never commit .env.watchdog.

# One variable per ONVIF camera (names must match password_env in
# config/config.yaml):
CAMERA_PORCH_PASSWORD=
CAMERA_DRIVEWAY_PASSWORD=

# Only if frigate.auth.mode is "frigate":
# FRIGATE_WATCHDOG_PASSWORD=

# Only if mqtt.password_env is set:
# MQTT_PASSWORD=
